# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform com a Routes API ativada
GOOGLE_MAPS_API_KEY=

# Empresa atendida por esta instalação
NEXT_PUBLIC_EMPRESA_SLUG=millenio
